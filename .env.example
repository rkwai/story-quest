NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Starter configuration; compare prose/continuity before selecting a winner.
STORY_MODEL=deepseek/deepseek-v4.1-flash
# Optional; defaults to STORY_MODEL. Must support JSON Schema structured outputs.
PROPOSAL_MODEL=deepseek/deepseek-v4.1-flash
PROPOSAL_REASONING_EFFORT=low
# Use low for GLM 5.3 Flash; omit for a non-reasoning model such as Cydonia.
STORY_REASONING_EFFORT=none
# Jev and the storyteller share OPENROUTER_API_KEY.
TYPESAFE_MODEL=~typesafe/jev-latest
# shadow runs one private advisory review per proposal using the OpenRouter key.
# off disables it. Jev cannot commit or veto world changes in this release.
TYPESAFE_MODE=shadow
